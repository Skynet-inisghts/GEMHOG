{
  "name": "gemhog",
  "version": "0.8.9",
  "description": "Diamond-hands terminal for Pons V2 tokens on Robinhood Chain.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build:cli": "tsc -p tsconfig.cli.json",
    "gemhog": "node bin/gemhog.mjs",
    "demo": "pnpm build:cli && node bin/gemhog.mjs demo",
    "render:readme": "pnpm build:cli && node scripts/render-readme.mjs",
    "doctor": "pnpm build:cli && node bin/gemhog.mjs doctor",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:cli && node --test test/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "commander": "^14.0.0",
    "marked": "^18.0.12",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}