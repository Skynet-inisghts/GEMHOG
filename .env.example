# Everything works with no keys at all. Every value below is an optional accelerator.

# --- network -----------------------------------------------------------------
# Leave RPC_URL empty to use the built-in public pair: publicnode for state
# reads (fast, generous, no eth_getLogs) and the official Robinhood RPC for
# logs (strict limits). Or give your own, comma-separated, preferred first;
# add #nologs after an endpoint that refuses eth_getLogs. One private provider
# can carry everything.
RPC_URL=

# Public RPC burst limits: requests in flight and minimum spacing between them.
# Raise these only on a private RPC.
RPC_IN_FLIGHT=3
RPC_SPACING_MS=50
RPC_LOGS_SPACING_MS=400

# --- optional keys -----------------------------------------------------------
# Free key from dev.blockscout.com; only useful if the public Blockscout limits
# ever slow down holder reads.
BLOCKSCOUT_API_KEY=

# Telegram alerts for hunt --follow (arrives in 0.4). Both empty = no alerts,
# and nothing is ever posted anywhere else.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
